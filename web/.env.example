# RECORD-360 / Raphl — environment template.
# Copy to `.env.local` for development, or set these in your host's env for production.
# Never commit a filled-in copy: `.env*` is gitignored (this template is the only exception).

# ─── Required ───────────────────────────────────────────────────────────────

# PostgreSQL connection strings (Prisma). Run `npx prisma migrate deploy` before first boot.
#
# Supabase (serverless host like Netlify): use BOTH strings from the Supabase dashboard
# (Project Settings → Database → Connection string):
#   DATABASE_URL = the POOLED "Transaction" string (Supavisor, port 6543) + ?pgbouncer=true
#                  — used at runtime so serverless functions don't exhaust connections.
#   DIRECT_URL   = the DIRECT string (port 5432) — used by `prisma migrate`.
# Local dev or a plain Postgres (no pooler): set DIRECT_URL to the same value as DATABASE_URL.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# NextAuth (Auth.js v5) session/JWT signing secret. Generate one with:
#   openssl rand -base64 32        (or:  npx auth secret)
AUTH_SECRET="replace-me-with-a-32-byte-random-secret"

# Set to "true" when self-hosting behind a reverse proxy (anything other than Vercel).
# Auth.js needs this to trust the X-Forwarded-* host headers. Omit/false on Vercel.
AUTH_TRUST_HOST="true"

# Public base URL of the deployment (used in emails, QR codes, and absolute links).
# No trailing slash. Production: https://raphel360.com
# Local dev: use http://localhost:3000 (or leave unset — code falls back to it).
APP_URL="https://raphel360.com"

# ─── Media storage ──────────────────────────────────────────────────────────
# Setting S3_BUCKET switches uploads to S3-compatible object storage (e.g. Cloudflare R2).
# WITHOUT it, files are written to local disk (.uploads) — fine for dev, but LOST on every
# redeploy. Production MUST set these.
S3_BUCKET="record360"
S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="your-access-key-id"
S3_SECRET_ACCESS_KEY="your-secret-access-key"
S3_REGION="auto"   # R2 ignores region; "auto" is the convention. Optional (defaults to "auto").

# ─── Email (Resend) ─────────────────────────────────────────────────────────
# Used for activation links, password-reset links, and operator notices.
# The sender domain must be VERIFIED in Resend (SPF + DKIM DNS records) first —
# see docs/deployment-raphel360.md. Production sender: no-reply@raphel360.com.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Raphel <no-reply@raphel360.com>"

# ─── AI report generation (Informes) ────────────────────────────────────────
# Server-side only. Generation uses claude-sonnet-4-6 (~US$0.06-0.36 per informe).
ANTHROPIC_API_KEY="sk-ant-..."

# ─── Development only ───────────────────────────────────────────────────────
# Set DEV_TUNNEL=1 to allow *.trycloudflare.com origins when running `next dev`
# behind a Cloudflare quick tunnel. Has no effect in production.
# DEV_TUNNEL=1
