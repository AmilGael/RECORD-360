generator client {
  provider = "prisma-client-js"
  // "native" for local dev; rhel-openssl-3.0.x for Netlify Functions (AWS Lambda runtime).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Runtime connection. On Supabase + serverless this is the POOLED string
  // (Supavisor, port 6543, with ?pgbouncer=true) to avoid exhausting connections.
  url       = env("DATABASE_URL")
  // Migrations need a DIRECT connection (Supabase port 5432). Used by `prisma migrate`.
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  MANAGER
  SUPERVISOR
  RESIDENT
}

enum RegistroCategory {
  MATERIALES
  PROCESOS
  EVENTUALIDADES
  OBSERVACIONES
  COSTOS
  PERSONAL
}

enum AttachmentType {
  IMAGE
  VIDEO
  PDF
  AUDIO
}

model Company {
  id        String    @id @default(cuid())
  name      String
  sealKey   String?
  users     User[]
  projects  Project[]
  auditLogs AuditLog[]
  createdAt DateTime  @default(now())
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  passwordHash       String?
  emailVerifiedAt    DateTime?
  name               String
  role               Role
  phone        String?
  photoKey     String?
  signatureKey String?
  companyId          String
  company            Company             @relation(fields: [companyId], references: [id])
  projectAssignments ProjectAssignment[]
  notifications      Notification[]
  signatures         Signature[]
  verificationTokens VerificationToken[]
  disabledAt         DateTime?
  createdAt          DateTime            @default(now())
}

model LoginAttempt {
  key             String   @id
  failures        Int      @default(0)
  windowStartedAt DateTime
  blockedUntil    DateTime?
  lastFailureAt   DateTime?
  updatedAt       DateTime @updatedAt
}

model Project {
  id             String          @id @default(cuid())
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id])
  name             String
  description      String?
  // WS4A: the owner (client) of the obra — the company is the contractor. Free
  // text by decision (least-complex model); NOT an address, NOT a user relation.
  ownerName        String?
  coverImageKey    String?
  registrationCode String  @unique
  partidas         Partida[]
  segments       Segment[]
  locations      Location[]
  changeRequests ChangeRequest[]
  documents      Document[]
  assignments    ProjectAssignment[]
  tags           PartidaTag[]
  informes       Informe[]
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
}

model ProjectAssignment {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId, role])
}

model Partida {
  id             String                 @id @default(cuid())
  projectId      String
  project        Project                @relation(fields: [projectId], references: [id])
  segmentId      String?
  segment        Segment?               @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  name           String
  deletedAt      DateTime?
  deletedById    String?
  progressPct    Int                    @default(0)
  // Lifecycle (WS8): completedAt==null → open. Progress 100 is reachable ONLY
  // via Conclude; manual updates cap at 99. priorProgressPct restores on reopen.
  completedAt     DateTime?
  completedById   String?
  priorProgressPct Int?
  registros      Registro[]
  changeRequests ChangeRequestPartida[]
  tags           PartidaTagOnPartida[]
  signatures     Signature[]
  createdAt      DateTime               @default(now())

  @@index([segmentId])
}

model Segment {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id])
  name      String
  // Lifecycle (WS4C): closedAt==null → open. Close requires every non-deleted
  // partida concluded (empty block may close). Closed blocks reject new partidas.
  closedAt   DateTime?
  closedById String?
  position  Int       @default(0)
  partidas  Partida[]
  changes   ChangeRequestSegment[]
  createdAt DateTime  @default(now())

  @@unique([projectId, name])
}

model PartidaTag {
  id        String                @id @default(cuid())
  projectId String
  project   Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  partidas  PartidaTagOnPartida[]
  createdAt DateTime              @default(now())

  @@unique([projectId, name])
  @@index([projectId])
}

model PartidaTagOnPartida {
  partidaId String
  partida   Partida    @relation(fields: [partidaId], references: [id], onDelete: Cascade)
  tagId     String
  tag       PartidaTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([partidaId, tagId])
  @@index([tagId])
}

model Location {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id])
  label     String
  registros Registro[]
  createdAt DateTime   @default(now())

  @@unique([projectId, label])
}

model Attachment {
  id         String         @id @default(cuid())
  registroId String
  registro   Registro       @relation(fields: [registroId], references: [id], onDelete: Cascade)
  url        String
  sha256     String
  fileType   AttachmentType

  @@index([registroId])
}

model Registro {
  id              String            @id @default(cuid())
  partidaId       String
  partida         Partida           @relation(fields: [partidaId], references: [id])
  text            String?
  category        RegistroCategory?
  locationId      String?
  location        Location?         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  ledgerVersion   Int               @default(2)
  attachments     Attachment[]
  progressPct     Int?
  authorId        String
  serverCreatedAt DateTime
  gpsLat          Decimal?          @db.Decimal(9, 6)
  gpsLng          Decimal?          @db.Decimal(9, 6)
  prevHash        String
  hash            String
  correctionOfId  String?
  replyToId       String?
  replyTo         Registro?         @relation("RegistroReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         Registro[]        @relation("RegistroReplies")
  reminderDueAt   DateTime?
  reminderResolvedAt DateTime?
  changeRequestId  String?
  changeRequest    ChangeRequest?    @relation("RegistroChange", fields: [changeRequestId], references: [id], onDelete: SetNull)
  idempotencyKey   String?                      // client UUID for offline-capture dedupe; NOT in computeHash
  clientCapturedAt DateTime?                   // when written on-site (offline); NOT in computeHash; metadata only

  @@unique([partidaId, prevHash])
  // Dedup is scoped to the partida (which the caller is access-checked against),
  // never global — prevents idempotency replay from resolving cross-tenant (IDOR).
  @@unique([partidaId, idempotencyKey])
  @@index([partidaId, serverCreatedAt])
  @@index([replyToId])
}

enum ChangeStatus {
  OPEN
  INTEGRATED
  REJECTED
}

enum RequestKind {
  CHANGE
  ALERT
}

enum RequestSeverity {
  IMPORTANT
  CRITICAL
}

enum InformeArchetype {
  OWNER
  SENIOR_MANAGEMENT
  PERSONAL_FEEDBACK
}

enum NotificationSeverity {
  SUCCESS
  IMPORTANT
  CRITICAL
}

model ChangeRequest {
  id           String       @id @default(cuid())
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id])
  code         String
  // WS5: kind+severity. DB default backfills existing rows as CHANGE/IMPORTANT;
  // the creation form requires an explicit choice (no preselect). Severity is
  // ledger state, never a display-only tag.
  kind         RequestKind     @default(CHANGE)
  severity     RequestSeverity @default(IMPORTANT)
  title        String
  description  String?
  costImpact   Decimal?     @db.Decimal(12, 2)
  daysImpact   Int?
  status       ChangeStatus @default(OPEN)
  authorId     String
  gpsLat       Decimal?     @db.Decimal(9, 6)
  gpsLng       Decimal?     @db.Decimal(9, 6)
  resolvedById String?
  resolvedAt   DateTime?
  rejectionReason String?
  resolutionNote  String?
  reminderDueAt   DateTime?
  seal         String?
  createdAt    DateTime     @default(now())

  partidas    ChangeRequestPartida[]
  segments    ChangeRequestSegment[]
  attachments ChangeAttachment[]
  markers     Registro[]             @relation("RegistroChange")

  @@unique([projectId, code])
  @@index([projectId, status])
}

model ChangeRequestSegment {
  changeRequestId String
  changeRequest   ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  segmentId       String
  segment         Segment       @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@id([changeRequestId, segmentId])
  @@index([segmentId])
}

model ChangeRequestPartida {
  changeRequestId String
  changeRequest   ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  partidaId       String
  partida         Partida       @relation(fields: [partidaId], references: [id])

  @@id([changeRequestId, partidaId])
  @@index([partidaId])
}

model ChangeAttachment {
  id              String         @id @default(cuid())
  changeRequestId String
  changeRequest   ChangeRequest  @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  url             String
  sha256          String
  fileType        AttachmentType

  @@index([changeRequestId])
}

enum DocumentKind {
  PLANO
  DOCUMENTO
  LEVANTAMIENTO
  IDEA
  MINUTA
  PLANO_ACTUALIZADO
}

model Document {
  id           String       @id @default(cuid())
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id])
  segmentId    String?      // per-Bloque plan spaces are P4; null = project-level
  kind         DocumentKind @default(PLANO)
  title        String?
  url          String
  sha256       String
  fileType     AttachmentType
  uploadedById String
  createdAt    DateTime     @default(now())

  @@index([projectId, kind, createdAt])
}

// AI-generated informe (spec R2.2 "Report" table). Deterministic PDF reports are
// stateless routes; informes persist because they are auditable deliverables.
model Informe {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  segmentId     String?
  partidaId     String?
  requestedById String
  // WS7: audience archetype. Nullable = legacy informes created before archetypes;
  // new writes always set it.
  archetype     InformeArchetype?
  brief         String
  periodFrom    DateTime?
  periodTo      DateTime?
  contentMd     String
  model         String
  createdAt     DateTime @default(now())
  // M2: deterministic fingerprint of the request inputs (requester + scope +
  // archetype + brief + period), computed server-side so a client cannot forge
  // or bypass it. Unique, so a resubmitted identical request can never create a
  // second row — and never a second paid generation once the first has landed.
  // Nullable for legacy rows; Postgres allows many NULLs under a unique index.
  idempotencyKey String? @unique
  // Background-generation lifecycle: the row is created PENDING before the AI
  // call and flipped to READY/FAILED after, so a dropped response or killed
  // invocation leaves visible, retryable state instead of silence. Default
  // READY keeps every legacy row (which always has content) downloadable; new
  // writes always set PENDING explicitly.
  status        InformeStatus @default(READY)
  errorMessage  String?
  // When this generation attempt started (stale-PENDING reclaim measures from
  // here) and when content landed. Nullable on legacy rows.
  startedAt     DateTime?
  generatedAt   DateTime?

  @@index([projectId, createdAt])
}

enum InformeStatus {
  PENDING
  READY
  FAILED
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actorId    String
  action     String
  targetType String
  targetId   String
  summary    String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

model Notification {
  id        String    @id @default(cuid())
  companyId String
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String
  // WS3: canonical typed event key (events.ts). `type` mirrors it for new rows;
  // legacy rows carry cambio.* in `type` with eventKey null (aliased in filters).
  eventKey  String?
  severity  NotificationSeverity?
  projectId String?
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([userId, projectId, createdAt])
}

model Signature {
  id         String   @id @default(cuid())
  companyId  String
  partidaId  String
  partida    Partida  @relation(fields: [partidaId], references: [id], onDelete: Cascade)
  signerId   String
  signer     User     @relation(fields: [signerId], references: [id])
  signerName String
  signerRole Role
  statement  String?
  chainHead  String
  seal       String
  signedAt   DateTime @default(now())

  @@index([partidaId])
}

enum TokenPurpose {
  ACTIVATION
  PASSWORD_RESET
}

model VerificationToken {
  id         String       @id @default(cuid())
  tokenHash  String       @unique
  purpose    TokenPurpose
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([userId])
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model AccessRequest {
  id               String        @id @default(cuid())
  businessName     String
  contactName      String
  email            String
  phone            String
  website          String?
  message          String?
  status           RequestStatus @default(PENDING)
  reviewedById     String?
  reviewedAt       DateTime?
  createdCompanyId String?
  createdUserId    String?
  createdAt        DateTime      @default(now())

  @@index([status, createdAt])
}
