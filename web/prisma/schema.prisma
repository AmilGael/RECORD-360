generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  SUPERVISOR
  RESIDENT
}

enum RegistroCategory {
  MATERIALES
  PROCESOS
  EVENTUALIDADES
  OBSERVACIONES
  COSTOS
  PERSONAL
}

enum AttachmentType {
  IMAGE
  VIDEO
  PDF
  AUDIO
}

model Company {
  id        String    @id @default(cuid())
  name      String
  users     User[]
  projects  Project[]
  createdAt DateTime  @default(now())
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  createdAt    DateTime @default(now())
}

model Project {
  id             String          @id @default(cuid())
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id])
  name           String
  description    String?
  partidas       Partida[]
  segments       Segment[]
  locations      Location[]
  changeRequests ChangeRequest[]
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
}

model Partida {
  id             String                 @id @default(cuid())
  projectId      String
  project        Project                @relation(fields: [projectId], references: [id])
  segmentId      String?
  segment        Segment?               @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  name           String
  progressPct    Int                    @default(0)
  registros      Registro[]
  changeRequests ChangeRequestPartida[]
  createdAt      DateTime               @default(now())

  @@index([segmentId])
}

model Segment {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id])
  name      String
  position  Int       @default(0)
  partidas  Partida[]
  createdAt DateTime  @default(now())

  @@unique([projectId, name])
}

model Location {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id])
  label     String
  registros Registro[]
  createdAt DateTime   @default(now())

  @@unique([projectId, label])
}

model Attachment {
  id         String         @id @default(cuid())
  registroId String
  registro   Registro       @relation(fields: [registroId], references: [id], onDelete: Cascade)
  url        String
  sha256     String
  fileType   AttachmentType

  @@index([registroId])
}

model Registro {
  id              String            @id @default(cuid())
  partidaId       String
  partida         Partida           @relation(fields: [partidaId], references: [id])
  text            String?
  category        RegistroCategory?
  locationId      String?
  location        Location?         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  ledgerVersion   Int               @default(2)
  attachments     Attachment[]
  progressPct     Int?
  authorId        String
  serverCreatedAt DateTime
  gpsLat          Decimal?          @db.Decimal(9, 6)
  gpsLng          Decimal?          @db.Decimal(9, 6)
  prevHash        String
  hash            String
  correctionOfId  String?
  changeRequestId String?
  changeRequest   ChangeRequest? @relation("RegistroChange", fields: [changeRequestId], references: [id], onDelete: SetNull)

  @@unique([partidaId, prevHash])
  @@index([partidaId, serverCreatedAt])
}

enum ChangeStatus {
  OPEN
  INTEGRATED
  REJECTED
}

model ChangeRequest {
  id           String       @id @default(cuid())
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id])
  code         String
  title        String
  description  String?
  costImpact   Decimal?     @db.Decimal(12, 2)
  daysImpact   Int?
  status       ChangeStatus @default(OPEN)
  authorId     String
  gpsLat       Decimal?     @db.Decimal(9, 6)
  gpsLng       Decimal?     @db.Decimal(9, 6)
  resolvedById String?
  resolvedAt   DateTime?
  seal         String?
  createdAt    DateTime     @default(now())

  partidas    ChangeRequestPartida[]
  attachments ChangeAttachment[]
  markers     Registro[]   @relation("RegistroChange")

  @@unique([projectId, code])
  @@index([projectId, status])
}

model ChangeRequestPartida {
  changeRequestId String
  changeRequest   ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  partidaId       String
  partida         Partida       @relation(fields: [partidaId], references: [id])

  @@id([changeRequestId, partidaId])
}

model ChangeAttachment {
  id              String         @id @default(cuid())
  changeRequestId String
  changeRequest   ChangeRequest  @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  url             String
  sha256          String
  fileType        AttachmentType

  @@index([changeRequestId])
}
