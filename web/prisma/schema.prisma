generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  SUPERVISOR
  RESIDENT
}

enum RegistroType {
  NOTE
  PHOTO
}

model Company {
  id        String    @id @default(cuid())
  name      String
  users     User[]
  projects  Project[]
  createdAt DateTime  @default(now())
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  createdAt    DateTime @default(now())
}

model Project {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  name        String
  description String?
  partidas    Partida[]
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
}

model Partida {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id])
  name        String
  progressPct Int        @default(0)
  registros   Registro[]
  createdAt   DateTime   @default(now())
}

model Registro {
  id              String       @id @default(cuid())
  partidaId       String
  partida         Partida      @relation(fields: [partidaId], references: [id])
  type            RegistroType
  text            String?
  mediaUrl        String?
  progressPct     Int?
  authorId        String
  serverCreatedAt DateTime
  gpsLat          Decimal?     @db.Decimal(9, 6)
  gpsLng          Decimal?     @db.Decimal(9, 6)
  prevHash        String
  hash            String
  correctionOfId  String?

  @@unique([partidaId, prevHash])
  @@index([partidaId, serverCreatedAt])
}
